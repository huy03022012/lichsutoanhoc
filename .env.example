# Khóa chỉ được đọc ở backend, tuyệt đối không đặt trong mã frontend.
GEMINI_API_KEY=
# Các khóa Gemini dự phòng, phân tách bằng dấu phẩy; khi một khóa hết quota sẽ thử khóa kế tiếp.
GEMINI_API_KEYS=
# Chỉ backend dùng URL và service-role key để truy cập dữ liệu; tuyệt đối không thêm tiền tố VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile site key công khai dùng trong frontend; khóa secret chỉ backend dùng.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Gmail SMTP: use a Google App Password, not your normal account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Cổng của Express local; Vercel tự cấp cổng cho serverless function.
PORT=3000
# Cho phép frontend local gọi Express; thêm domain frontend khi tự host riêng.
CLIENT_ORIGIN=http://localhost:5173
# Chỉ bật trust proxy khi biết chính xác reverse proxy phía trước server.
TRUST_PROXY=0
# Chỉ đặt đường dẫn này khi môi trường chạy có ổ đĩa lưu trữ bền vững.
PROGRESS_FILE=
